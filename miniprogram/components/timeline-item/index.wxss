.timeline-item {
  position: relative;
  padding-left: 64rpx;
  margin-bottom: 40rpx;
}

/* 时间点 */
.time-dot {
  position: absolute;
  left: -4rpx;
  top: 0;
  width: 48rpx;
  height: 48rpx;
  border-radius: var(--radius-full);
  border: 4rpx solid #3B82F6;
  background: var(--bg-card);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

.dot-inner {
  width: 18rpx;
  height: 16rpx;
  border-radius: var(--radius-full);
}

/* 时间标签 */
.time-label {
  margin-bottom: 8rpx;
}

.time-text {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-secondary);
}

/* 行程卡片 */
.trip-detail-card {
  background: var(--bg-card);
  border-radius: var(--radius-md);
  border: 1rpx solid var(--border-light);
  box-shadow: var(--shadow-sm);
  padding: 32rpx;
}

.detail-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.detail-title-area {
  flex: 1;
}

.detail-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  display: block;
  margin-bottom: 4rpx;
}

.detail-location {
  display: flex;
  align-items: center;
}

.loc-icon {
  font-size: 28rpx;
  color: var(--text-muted);
  margin-right: 8rpx;
}

.loc-text {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.detail-tag {
  padding: 4rpx 12rpx;
  border-radius: var(--radius-sm);
  white-space: nowrap;
}

.tag-text {
  font-size: 22rpx;
  font-weight: 500;
}

/* 描述 */
.detail-desc {
  margin-bottom: 16rpx;
}

.desc-text {
  font-size: 26rpx;
  color: #475569;
  line-height: 1.5;
}

/* 图片 */
.detail-image {
  width: 100%;
  height: 240rpx;
  border-radius: var(--radius-sm);
  margin-bottom: 16rpx;
}

/* 菜品 */
.dish-row {
  display: flex;
  gap: 24rpx;
  margin-bottom: 16rpx;
}

.dish-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.dish-img {
  width: 160rpx;
  height: 120rpx;
  border-radius: 12rpx;
  margin-bottom: 8rpx;
}

.dish-name {
  font-size: 22rpx;
  color: var(--text-primary);
  text-align: center;
}

/* 演出时间表 */
.schedule-box {
  background: var(--bg-input);
  border-radius: var(--radius-sm);
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.schedule-title {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-primary);
  display: block;
  margin-bottom: 4rpx;
}

.schedule-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0;
}

.schedule-name {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.schedule-times {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 贴士 */
.tips-box {
  display: flex;
  align-items: flex-start;
  background: var(--color-warning-bg);
  border-radius: var(--radius-sm);
  padding: 16rpx 24rpx;
}

.tips-icon {
  font-size: 32rpx;
  color: #D97706;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.tips-text {
  font-size: 24rpx;
  color: #D97706;
  line-height: 1.4;
  flex: 1;
}
