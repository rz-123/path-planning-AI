/**
 * ============================================================================
 * pages/index/index.wxss — 首页样式
 * ============================================================================
 * 微信小程序 WXSS 特有单位：
 *   - rpx: 响应式像素，750rpx = 屏幕宽度（自适应所有设备）
 *   - vh:  视口高度百分比（100vh = 满屏高度）
 * 
 * flex 布局核心属性：
 *   - display: flex        启用 flex 布局
 *   - flex-direction: column  垂直排列（主轴方向）
 *   - justify-content: space-between  两端对齐
 *   - align-items: center   交叉轴居中
 * ============================================================================
 */

/* ===== 页面容器 ===== */
.page-home {
  height: 100vh;                    /* 满屏高度，防止内容不足时露出底层背景 */
  display: flex;                    /* flex 布局 */
  flex-direction: column;           /* 垂直排列（header → scroll-view） */
  background: var(--bg-page);       /* 使用全局 CSS 变量 */
  overflow: hidden;                 /* 防止页面级滚动（由 scroll-view 接管滚动） */
}

/* ===== 自定义导航栏 ===== */
.header {
  flex-shrink: 0;                   /* flex 布局中不被压缩（保持固定高度） */
  background: var(--bg-card);
  z-index: 100;                     /* 叠加层级：确保导航栏在最上层 */
}

.header-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;   /* 标题居中 + 右侧图标在右 */
  height: 88rpx;                    /* ≈44px，微信标准导航栏高度 */
  padding: 0 32rpx;
}

.header-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.header-right {
  display: flex;
  align-items: center;
  gap: 24rpx;                       /* 图标间距 */
}

.header-icon {
  font-size: 40rpx;
  color: var(--text-primary);
}

/* ===== 滚动区域 ===== */
.main-scroll {
  flex: 1;                          /* 占满导航栏下方的所有空间 */
  padding: 32rpx;
  box-sizing: border-box;           /* padding 算在总宽度内 */
}

/* ===== Banner 横幅 ===== */
.banner {
  position: relative;               /* 为 SVG 装饰的绝对定位提供参考 */
  background: var(--gradient-primary); /* 青→蓝渐变 */
  border-radius: var(--radius-xl);    /* 大圆角 */
  padding: 40rpx;
  margin-bottom: 48rpx;
  overflow: hidden;                 /* 隐藏超出圆角的 SVG 装饰 */
}

.banner-decor {
  position: absolute;               /* 绝对定位：从文档流中脱离 */
  right: -20rpx;                    /* SVG 略微超出右边界（创造视觉层次） */
  top: -20rpx;
  opacity: 0.15;                    /* 半透明：不抢夺文字焦点 */
}

.banner-content {
  position: relative;               /* z-index 只在定位元素上生效 */
  z-index: 1;                       /* 文字在 SVG 装饰之上 */
}

.banner-title {
  font-size: 48rpx;                 /* ≈24px，大标题 */
  font-weight: 700;
  color: var(--text-white);
  line-height: 1.3;                 /* 行高比例：130% 字体大小 */
  margin-bottom: 16rpx;
  display: block;                   /* text 默认为 inline，改 block 可设 margin */
}

.banner-desc {
  font-size: 28rpx;
  color: rgba(255,255,255,0.9);     /* 90% 不透明度白色 */
  margin-bottom: 32rpx;
  display: block;
}

.banner-btn {
  display: inline-flex;             /* inline 宽度自适应内容 + flex 内子元素对齐 */
  align-items: center;              /* 按钮内图标和文字垂直居中 */
  background: var(--text-white);    /* 白色背景 + 青色文字 = 高对比度 */
  border-radius: var(--radius-full); /* 胶囊形状 */
  padding: 16rpx 32rpx;
}

.banner-btn-text {
  font-size: 28rpx;
  font-weight: 500;
  color: #016B9C;                   /* 深青色 */
  margin-right: 8rpx;
}

.banner-btn-icon {
  font-size: 32rpx;
  color: var(--color-primary);
}

/* ===== 通用区块 ===== */
.section { margin-bottom: 48rpx; }

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;   /* 标题在左，副操作在右 */
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 36rpx;                 /* ≈18px，区块标题 */
  font-weight: 600;
  color: var(--text-primary);
}

.section-more {
  font-size: 28rpx;
  color: var(--text-secondary);     /* 次要文字颜色 */
}

/* ===== 行程卡片列表 ===== */
.recent-list {
  display: flex;
  flex-direction: column;           /* 垂直排列卡片 */
  gap: 24rpx;                       /* 卡片间距（flex gap 属性） */
}

.recent-card {
  background: var(--bg-card);
  border-radius: var(--radius-md);
  border: 1rpx solid var(--border-light);
  box-shadow: var(--shadow-sm);     /* 轻微浮起效果 */
  padding: 32rpx;
}

.recent-card-top {
  display: flex;
  align-items: flex-start;          /* 顶对齐：标题和标签顶部对齐 */
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.recent-info { flex: 1; }          /* 占满剩余空间 */

.recent-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  display: block;
  margin-bottom: 8rpx;
}

.recent-date {
  font-size: 26rpx;
  color: var(--text-secondary);
}

/* 状态标签 */
.recent-tag {
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: var(--radius-sm);
  font-weight: 500;
  white-space: nowrap;              /* 不换行 */
  flex-shrink: 0;                   /* 不被压缩 */
}

.tag-completed { background: var(--color-blue-light); color: var(--color-blue); }
.tag-draft { background: var(--color-orange-bg); color: var(--color-orange); }

.recent-card-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.recent-budget { display: flex; align-items: center; }
.budget-icon { font-size: 32rpx; color: var(--color-success); margin-right: 8rpx; }
.budget-text { font-size: 26rpx; color: #10B981; font-weight: 500; }

/* ===== 空状态 ===== */
.empty-recent {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}
.empty-icon { font-size: 72rpx; color: #CBD5E1; margin-bottom: 20rpx; }
.empty-text { font-size: 28rpx; color: #94A3B8; margin-bottom: 8rpx; }
.empty-hint { font-size: 24rpx; color: #CBD5E1; }

/* ===== 热门目的地 ===== */
/* scroll-x: 横向滚动容器 */
.dest-scroll {
  white-space: nowrap;              /* 强制子元素不换行（横向滚动的前提） */
  padding-bottom: 16rpx;
}

/* inline-flex: 水平排列 + 内部 flex 布局 */
.dest-card {
  display: inline-flex;
  flex-direction: column;
  width: 280rpx;                    /* 固定宽度，形成卡片流 */
  margin-right: 24rpx;
  background: var(--bg-card);
  border-radius: var(--radius-md);
  border: 1rpx solid var(--border-light);
  box-shadow: var(--shadow-sm);
  overflow: hidden;                 /* 圆角裁切图片 */
}

.dest-image {
  width: 280rpx;
  height: 200rpx;                   /* 图片区域高度 */
}

.dest-info { padding: 24rpx; }
.dest-name { font-size: 30rpx; font-weight: 600; color: var(--text-primary); display: block; margin-bottom: 4rpx; }
.dest-tags {
  font-size: 24rpx;
  color: var(--text-secondary);
  overflow: hidden;                 /* 超出隐藏 */
  text-overflow: ellipsis;          /* 文字溢出显示 ... */
  white-space: nowrap;
  display: block;
}
