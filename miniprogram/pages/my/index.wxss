/**
 * ============================================================================
 * pages/my/index.wxss — "我的"页面样式（236行）
 * ============================================================================
 * 布局：导航 → 滚动区（用户卡片 → 统计 → 快速操作 → 历史列表 → 空状态）
 * ============================================================================
 */

/* ===== 页面容器 ===== */
.page-my {                                       /* "我的"页面根容器 */
  height: 100vh;                                 /* 满屏高度 */
  display: flex;                                 /* flex布局 */
  flex-direction: column;                        /* 垂直方向：导航在上，内容在下 */
  background: var(--bg-page);                    /* 页面底色 */
  overflow: hidden;                              /* 隐藏滚动条 */
}

/* ===== 导航栏 ===== */
.nav-header { flex-shrink: 0; background: var(--bg-card); z-index: 100; }
/* flex-shrink:0 → 固定高度，不被内容区压缩 */
.nav-header-inner {
  display: flex;                                 /* 水平布局 */
  align-items: center;                           /* 垂直居中 */
  justify-content: center;                       /* 标题居中（不同于create页的左对齐） */
  height: 88rpx;                                 /* 标准导航栏高度 44px */
  padding: 0 32rpx;
  position: relative;                            /* 为右侧图标的绝对定位提供参考 */
}
.nav-title { font-size: 34rpx; font-weight: 600; color: var(--text-primary); }
.nav-right { position: absolute; right: 32rpx; }
/* 右侧图标用绝对定位 → 不影响标题居中 */
.nav-right-icon { font-size: 40rpx; color: var(--text-primary); }

/* ===== 滚动区 ===== */
.main-scroll { flex: 1; padding: 32rpx; box-sizing: border-box; }
/* flex:1 → 占满导航栏下方所有空间 */

/* ===== 用户信息卡片（渐变背景 + 大头像） ===== */
.user-card {
  display: flex;
  flex-direction: column;                        /* 头像在上，文字在下 */
  align-items: center;                           /* 水平居中 */
  background: var(--gradient-primary);            /* 青→蓝渐变背景 */
  border-radius: var(--radius-xl);               /* 大圆角 */
  padding: 48rpx 32rpx 32rpx;                    /* 上多下少 */
  margin-bottom: 24rpx;
}

.user-avatar {
  width: 128rpx;                                 /* ≈64px 大头像 */
  height: 128rpx;
  border-radius: var(--radius-full);              /* 正圆形 */
  background: rgba(255,255,255,0.2);              /* 半透明白色背景 */
  border: 4rpx solid rgba(255,255,255,0.4);       /* 白色描边 */
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

.avatar-icon { font-size: 64rpx; color: var(--text-white); }

.user-name {
  font-size: 36rpx; font-weight: 700;
  color: var(--text-white);                       /* 白色文字在渐变背景上 */
  margin-bottom: 8rpx;
}

.user-id {
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);                   /* 80%不透明度白色 */
}

/* ===== 统计面板（3列：行程数 | 天数 | 最爱目的地） ===== */
.stats-row {
  display: flex;                                  /* 水平排列3项 */
  background: var(--bg-card);                    /* 白底 */
  border-radius: var(--radius-md);
  border: 1rpx solid var(--border-light);
  box-shadow: var(--shadow-sm);
  padding: 32rpx 0;                               /* 上下内边距 */
  margin-bottom: 32rpx;
}

.stat-item {
  flex: 1;                                       /* 3项等分宽度 */
  display: flex;
  flex-direction: column;                        /* 数字在上，标签在下 */
  align-items: center;                           /* 水平居中 */
}

.stat-num {
  font-size: 40rpx;                              /* 大号数字 */
  font-weight: 700;
  color: var(--color-primary-dark);              /* 深青色 */
  margin-bottom: 4rpx;
}

.stat-label {
  font-size: 24rpx;                              /* 小号标签 */
  color: var(--text-secondary);                  /* 灰色 */
}

.stat-divider {
  width: 2rpx;                                   /* 竖线宽度 */
  height: 56rpx;                                 /* 竖线高度 */
  background: var(--border-light);               /* 浅灰色分隔线 */
}

/* ===== 快速操作入口（"开始新规划"卡） ===== */
.quick-action {
  display: flex;
  align-items: center;
  justify-content: space-between;                /* 左侧内容 + 右侧箭头 */
  background: var(--color-primary-light);        /* 浅蓝色背景 */
  border: 1rpx solid var(--color-primary-border);
  border-radius: var(--radius-md);
  padding: 32rpx;
  margin-bottom: 40rpx;
}

.qa-left { display: flex; align-items: center; }

.qa-icon-box {
  width: 80rpx; height: 80rpx;
  border-radius: var(--radius-md);
  background: var(--gradient-primary);            /* 渐变蓝色方块 */
  display: flex; align-items: center; justify-content: center;
  margin-right: 24rpx;
}

.qa-icon { font-size: 40rpx; color: var(--text-white); }
.qa-title { font-size: 30rpx; font-weight: 600; color: var(--text-primary); display: block; margin-bottom: 4rpx; }
.qa-desc { font-size: 24rpx; color: var(--text-secondary); }
.qa-arrow { font-size: 32rpx; color: var(--color-primary-dark); }
/* 右箭头：深青色，暗示可点击 */

/* ===== 行程记录区块 ===== */
.section { margin-bottom: 48rpx; }

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;                /* 标题在左，数量在右 */
  margin-bottom: 24rpx;
}

.section-title { font-size: 36rpx; font-weight: 600; color: var(--text-primary); }
.section-count { font-size: 26rpx; color: var(--text-muted); }
/* 如 "7条" 灰色小字 */

/* ===== 历史行程卡片列表 ===== */
.history-list {
  display: flex;
  flex-direction: column;                        /* 垂直排列卡片 */
}

/* 相邻卡片选择器：.history-card + .history-card = 不是第一个的卡片 */
/* 给后续卡片添加上边距 */
.history-card + .history-card {
  margin-top: 20rpx;
}

.history-card {
  display: flex;                                 /* 日期方块 + 内容区 横向排列 */
  background: var(--bg-card);
  border-radius: var(--radius-md);
  border: 1rpx solid var(--border-light);
  box-shadow: var(--shadow-sm);
  padding: 28rpx;
}

/* 左侧：日期方块 */
.hc-left { flex-shrink: 0; margin-right: 24rpx; }
/* flex-shrink:0 → 固定宽度，不被右侧挤压 */

.hc-date-box {
  width: 88rpx; height: 88rpx;
  border-radius: var(--radius-md);
  background: var(--color-blue-light);           /* 浅蓝色背景 */
  display: flex;
  flex-direction: column;                        /* 月份在上，日期在下 */
  align-items: center; justify-content: center;
}

.hc-month { font-size: 22rpx; color: var(--color-blue); font-weight: 500; }
/* 如 "6月" 小字 */
.hc-day { font-size: 30rpx; color: var(--color-blue); font-weight: 700; }
/* 如 "15" 大字加粗 */

/* 右侧：行程信息 */
.hc-body { flex: 1; display: flex; flex-direction: column; }

.hc-top {
  display: flex; align-items: center;
  justify-content: space-between;                /* 标题在左，状态在右 */
  margin-bottom: 6rpx;
}

.hc-title { font-size: 30rpx; font-weight: 600; color: var(--text-primary); }

/* 状态标签 */
.hc-status {
  font-size: 22rpx; padding: 4rpx 14rpx;
  border-radius: var(--radius-sm); font-weight: 500;
  flex-shrink: 0;                                /* 不被挤压 */
}
.hc-status.completed { background: var(--color-blue-light); color: var(--color-blue); }
/* 已完成：蓝底蓝字 */
.hc-status.pending  { background: var(--color-warning-bg); color: #D97706; }
/* 待完成：黄底黄字 */
.hc-status.canceled { background: rgba(148,163,184,0.15); color: var(--text-muted); }
/* 已取消：灰底灰字 */

.hc-meta {
  font-size: 24rpx; color: var(--text-muted);
  margin-bottom: 12rpx;
  /* 如 "2025.06.01 - 2025.06.03 | 2人 | 美食,博物馆" */
}

.hc-bottom {
  display: flex; align-items: center;
  justify-content: space-between;                /* 价格在左，箭头在右 */
}

.hc-budget { font-size: 26rpx; font-weight: 600; color: #10B981; }
/* 预算金额：绿色 */
.hc-arrow { font-size: 28rpx; color: var(--text-muted); }
/* 右箭头：暗示可点击进入详情 */

/* ===== 空状态（无数据时居中显示） ===== */
.empty-state {
  display: flex; flex-direction: column;
  align-items: center;                          /* 水平居中 */
  padding: 120rpx 0;                            /* 大量上边距，视觉居中 */
}

.empty-icon {
  font-size: 96rpx;                             /* 大号图标 */
  color: var(--border-default);                 /* 最浅的灰色 */
  margin-bottom: 32rpx;
}

.empty-title {
  font-size: 30rpx; color: var(--text-secondary);
  margin-bottom: 8rpx;
}

.empty-desc { font-size: 26rpx; color: var(--text-muted); }
